@page "/conta"
@rendermode InteractiveServer

@using Barbearia.Configs
@using Barbearia.Models
@using Barbearia.Services
@inject SessaoDAO sessaoDAO
@inject EquipeDAO equipeDAO
@inject LogDAO logs
@inject AuthenticationService auth
@inject IJSRuntime JS
@inject MarcaDAO marcaDAO

@* Sem politica de tela: a propria conta nao e uma tela do catalogo, e
   barrar alguem de ver os proprios dados ou trocar a propria senha nao
   faria sentido. Exige apenas estar logado, pelo _Imports da pasta. *@

<PageTitle>Minha conta</PageTitle>

<h1>Minha conta</h1>

@if (membro == null)
{
    <p class="text-muted">Carregando…</p>
}
else
{
    <div class="grade-conta">
        <section class="cartao bloco-conta identidade">
            <span class="avatar-conta" aria-hidden="true">@membro.Iniciais</span>

            <div>
                <strong>@membro.NomeVisivel</strong>
                <span class="login-conta">@membro.NomeUsr</span>

                <dl class="dados-conta">
                    <div>
                        <dt>Cargo</dt>
                        <dd>@Texto(membro.NomeFuncao)</dd>
                    </div>
                    <div>
                        <dt>Perfil</dt>
                        <dd>
                            @Perfil.Rotulo(membro.PerfilUsr)
                            @if (membro.RaizUsr)
                            {
                                <span class="etiqueta-raiz">super-administrador</span>
                            }
                        </dd>
                    </div>
                    <div>
                        <dt>Último acesso</dt>
                        <dd>@(membro.UltimoLoginUsr?.ToString("dd/MM/yyyy 'às' HH:mm") ?? "—")</dd>
                    </div>
                </dl>
            </div>
        </section>

        <section class="cartao bloco-conta">
            <h2>Senha</h2>
            <p>
                Ao trocar a senha, as suas sessões abertas em outros dispositivos
                são encerradas.
            </p>
            <a href="/trocar-senha" class="btn btn-primary">Alterar senha</a>
        </section>

        <section class="cartao bloco-conta">
            <h2>Aparência</h2>
            <p>A escolha vale neste navegador.</p>

            <div class="escolha-tema" role="group" aria-label="Tema">
                <button type="button" class="@(tema == "claro" ? "ativo" : "")"
                        @onclick='() => TrocarTema("claro")'>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 17a5 5 0 1 0 0-10 5 5 0 0 0 0 10zM12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4" />
                    </svg>
                    Claro
                </button>
                <button type="button" class="@(tema == "escuro" ? "ativo" : "")"
                        @onclick='() => TrocarTema("escuro")'>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
                    </svg>
                    Escuro
                </button>
            </div>
        </section>

        <section class="cartao bloco-conta identidade-visual">
            <h2>Identidade visual</h2>
            @if (ehAdmin)
            {
                <p>
                    A logo e as cores da barbearia: valem para todo mundo que
                    usa o sistema.
                </p>
            }
            else
            {
                <p>
                    A logo e as cores valem só para você, neste navegador. As
                    da barbearia quem escolhe é o administrador.
                </p>
            }

            <div class="vitrine-logo @(temLogoPropria ? "propria" : "")">
                <Marca Variante="Marca.Tipo.Completa" Class="logo-amostra" />
            </div>

            @if (!string.IsNullOrEmpty(erroLogo))
            {
                <div class="alert alert-danger" role="alert">@erroLogo</div>
            }

            <div class="acoes-logo">
                <label class="btn btn-outline-secondary enviar-logo">
                    Enviar uma imagem
                    <InputFile accept="image/png,image/jpeg,image/webp,image/svg+xml"
                               OnChange="EscolherLogo" />
                </label>

                @if (temLogoPropria)
                {
                    <button type="button" class="link-texto" @onclick="RemoverLogo">
                        @(ehAdmin ? "Voltar à logo do sistema" : "Voltar à logo da barbearia")
                    </button>
                }
            </div>

            <p class="dica-logo">
                PNG, JPG, WebP ou SVG, até @(TamanhoMaximoLogo / 1024) KB. Fundo
                transparente fica melhor: a logo aparece sobre claro e sobre
                escuro.
            </p>

            <h3>Cor primária</h3>
            <p class="dica-cor">Onde hoje é laranja: botões, destaques e realces.</p>
            <div class="bolinhas" role="group" aria-label="Cor primária">
                @foreach (var opcao in OpcoesPrimarias)
                {
                    var escolhida = primaria == opcao.Chave;
                    <button type="button"
                            class="bolinha @(escolhida ? "escolhida" : "") @(opcao.Chave == Paleta.Padrao ? "padrao" : "")"
                            style="--amostra: @opcao.Hex; --ponto: @Paleta.TextoSobre(opcao.Hex)"
                            title="@RotuloDe(opcao)"
                            aria-label="@RotuloDe(opcao)"
                            aria-pressed="@escolhida.ToString().ToLowerInvariant()"
                            @onclick="() => TrocarPrimaria(opcao.Chave)">
                    </button>
                }
            </div>

            <h3>Cor secundária</h3>
            <p class="dica-cor">
                Onde hoje é preto: o fundo da lateral e os topos escuros do
                sistema. Escolhendo uma cor clara, a letra do menu vira
                escura sozinha.
            </p>
            <div class="bolinhas" role="group" aria-label="Cor secundária">
                @foreach (var opcao in OpcoesSecundarias)
                {
                    var escolhida = secundaria == opcao.Chave;
                    <button type="button"
                            class="bolinha @(escolhida ? "escolhida" : "") @(opcao.Chave == Paleta.Padrao ? "padrao" : "")"
                            style="--amostra: @opcao.Hex; --ponto: @Paleta.TextoSobre(opcao.Hex)"
                            title="@RotuloDe(opcao)"
                            aria-label="@RotuloDe(opcao)"
                            aria-pressed="@escolhida.ToString().ToLowerInvariant()"
                            @onclick="() => TrocarSecundaria(opcao.Chave)">
                    </button>
                }
            </div>
        </section>

        <section class="cartao bloco-conta sessoes">
            <h2>Meus acessos abertos</h2>
            <p>
                Onde esta conta está entrando agora. Se algum não for seu,
                encerre e troque a senha.
            </p>

            @if (!string.IsNullOrEmpty(erro))
            {
                <div class="alert alert-danger" role="alert">@erro</div>
            }

            <ul class="lista-sessoes">
                @foreach (var sessao in sessoes)
                {
                    <li>
                        <div>
                            <strong>
                                @sessao.Dispositivo
                                @if (sessao.EstaAtual)
                                {
                                    <span class="atual">este dispositivo</span>
                                }
                            </strong>
                            <span>
                                Desde @sessao.CriadoEm.ToString("dd/MM 'às' HH:mm")
                                · expira @sessao.ExpiraEm.ToString("dd/MM 'às' HH:mm")
                                @if (!string.IsNullOrWhiteSpace(sessao.Ip))
                                {
                                    <text> · @sessao.Ip</text>
                                }
                            </span>
                        </div>

                        @if (!sessao.EstaAtual)
                        {
                            <button type="button" class="btn btn-outline-secondary"
                                    @onclick="() => Encerrar(sessao)">
                                Encerrar
                            </button>
                        }
                    </li>
                }
            </ul>

            @if (sessoes.Count(s => !s.EstaAtual) > 0)
            {
                <button type="button" class="btn btn-outline-danger"
                        @onclick="EncerrarOutras">
                    Sair de todos os outros dispositivos
                </button>
            }
        </section>
    </div>
}

@code {
    private Usuario? membro;
    private List<Sessao> sessoes = new();
    private string tema = "claro";
    private string? erro;

    protected override async Task OnInitializedAsync()
    {
        await auth.PrepararAsync();

        var id = auth.GetUsuarioId();
        if (id == null) return;

        membro = equipeDAO.BuscarPorId(id.Value);

        CarregarSessoes();
    }

    protected override async Task OnAfterRenderAsync(bool primeiraVez)
    {
        if (!primeiraVez) return;

        var salvo = await JS.InvokeAsync<string>("tema.ler");
        if (salvo != tema) tema = salvo;

        // A escolha de cor e a logo moram no navegador: so da para saber
        // quais estao valendo depois que a pagina existe.
        await LerMarcaSalva();

        StateHasChanged();
    }

    private void CarregarSessoes()
    {
        var id = auth.GetUsuarioId();
        if (id == null) return;

        try
        {
            sessoes = sessaoDAO.ListarDoUsuario(id.Value, auth.GetToken());
            erro = null;
        }
        catch (Exception ex)
        {
            erro = ex.Message;
            sessoes = new();
        }
    }

    private void Encerrar(Sessao sessao)
    {
        var id = auth.GetUsuarioId();
        if (id == null) return;

        try
        {
            // So encerra sessao do proprio usuario: o DAO confere o dono.
            sessaoDAO.EncerrarPorId(sessao.IdSessao, id.Value);

            logs.Registrar(new Evento
            {
                Acao = Acoes.SessoesEncerradas,
                Descricao = "Encerrou um acesso aberto em outro dispositivo.",
                IdUsuario = id.Value,
                NomeGravado = auth.GetUsuarioNome()
            });

            CarregarSessoes();
        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }
    }

    private void EncerrarOutras()
    {
        var id = auth.GetUsuarioId();
        if (id == null) return;

        try
        {
            var quantas = sessaoDAO.EncerrarTodasDoUsuario(id.Value, auth.GetToken());

            logs.Registrar(new Evento
            {
                Acao = Acoes.SessoesEncerradas,
                Descricao = $"Encerrou {quantas} acesso(s) em outros dispositivos.",
                IdUsuario = id.Value,
                NomeGravado = auth.GetUsuarioNome()
            });

            CarregarSessoes();
        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }
    }

    private async Task TrocarTema(string novo)
    {
        if (novo == tema) return;

        tema = novo;
        await JS.InvokeVoidAsync("tema.aplicar", novo);
    }

    // ---------- identidade visual ----------

    /// <summary>
    /// Vira base64 numa string do localStorage, que cresce um terco no
    /// caminho e divide uma cota de poucos megabytes com o resto do
    /// sistema. Logo e desenho, nao fotografia: 400 KB sobram.
    /// </summary>
    private const int TamanhoMaximoLogo = 400 * 1024;

    /// <summary>Administrador grava para todos; os outros, so no proprio navegador.</summary>
    private bool ehAdmin => auth.EhAdmin();

    private string primaria = Paleta.Padrao;
    private string secundaria = Paleta.Padrao;
    private bool temLogoPropria;
    private string? erroLogo;

    /// <summary>A bolinha do padrao vem primeiro, antes das escolhas.</summary>
    private static readonly Paleta.Cor[] OpcoesPrimarias =
        new[] { new Paleta.Cor(Paleta.Padrao, "Padrão do sistema", Paleta.PrimariaPadrao) }
            .Concat(Paleta.Primarias).ToArray();

    private static readonly Paleta.Cor[] OpcoesSecundarias =
        new[] { new Paleta.Cor(Paleta.Padrao, "Padrão do sistema", Paleta.SecundariaPadrao) }
            .Concat(Paleta.Secundarias).ToArray();

    // Sem escolha propria, quem nao e administrador ve as cores da barbearia.
    private string RotuloDe(Paleta.Cor cor) =>
        cor.Chave == Paleta.Padrao && !ehAdmin ? "Igual à barbearia" : cor.Rotulo;

    private sealed class MarcaSalva
    {
        public string Primaria { get; set; } = Paleta.Padrao;
        public string Secundaria { get; set; } = Paleta.Padrao;

        /// <summary>
        /// So o sim ou nao. A imagem fica no navegador: trazer o base64
        /// dela para ca seria meio megabyte pelo circuito sem uso nenhum
        /// do lado do servidor.
        /// </summary>
        public bool TemLogo { get; set; }
    }

    private async Task LerMarcaSalva()
    {
        if (ehAdmin)
        {
            var global = marcaDAO.Ler();
            primaria = global.Primaria;
            secundaria = global.Secundaria;
            temLogoPropria = global.TemLogo;
            return;
        }

        var salva = await JS.InvokeAsync<MarcaSalva>("marca.ler");

        primaria = salva.Primaria;
        secundaria = salva.Secundaria;
        temLogoPropria = salva.TemLogo;
    }

    private Task TrocarPrimaria(string chave) =>
        chave == primaria ? Task.CompletedTask : AplicarCores(chave, secundaria);

    private Task TrocarSecundaria(string chave) =>
        chave == secundaria ? Task.CompletedTask : AplicarCores(primaria, chave);

    private async Task AplicarCores(string nova, string novaSecundaria)
    {
        primaria = nova;
        secundaria = novaSecundaria;

        // O CSS sai do C#: assim a bolinha e o tom aplicado nao podem
        // divergir, porque os dois leem a mesma Paleta.
        if (ehAdmin)
        {
            marcaDAO.SalvarCores(primaria, secundaria);
            await JS.InvokeVoidAsync("marca.aplicarCoresGlobais", Paleta.Css(primaria, secundaria));
            return;
        }

        await JS.InvokeVoidAsync("marca.aplicarCores",
            primaria, secundaria, Paleta.Css(primaria, secundaria));
    }

    private async Task EscolherLogo(InputFileChangeEventArgs e)
    {
        erroLogo = null;

        var arquivo = e.File;
        if (arquivo == null) return;

        if (!arquivo.ContentType.StartsWith("image/"))
        {
            erroLogo = "A logo precisa ser uma imagem.";
            return;
        }

        if (arquivo.Size > TamanhoMaximoLogo)
        {
            erroLogo = $"A imagem tem {arquivo.Size / 1024} KB. " +
                       $"O limite é {TamanhoMaximoLogo / 1024} KB.";
            return;
        }

        try
        {
            using var memoria = new MemoryStream();
            await arquivo.OpenReadStream(TamanhoMaximoLogo).CopyToAsync(memoria);

            if (ehAdmin)
            {
                marcaDAO.SalvarLogo(arquivo.ContentType, memoria.ToArray());
                await JS.InvokeVoidAsync("marca.aplicarLogoGlobal", marcaDAO.Ler().UrlLogo);
            }
            else
            {
                var dados = Convert.ToBase64String(memoria.ToArray());
                await JS.InvokeVoidAsync("marca.aplicarLogo",
                    $"data:{arquivo.ContentType};base64,{dados}");
            }

            temLogoPropria = true;
        }
        catch (Exception ex)
        {
            erroLogo = ex.Message;
        }
    }

    private async Task RemoverLogo()
    {
        erroLogo = null;

        if (ehAdmin)
        {
            marcaDAO.SalvarLogo(null, null);
            await JS.InvokeVoidAsync("marca.aplicarLogoGlobal", (string?)null);
        }
        else
        {
            await JS.InvokeVoidAsync("marca.aplicarLogo", (string?)null);
        }

        temLogoPropria = false;
    }

    private static string Texto(string? valor) =>
        string.IsNullOrWhiteSpace(valor) ? "—" : valor;
}
