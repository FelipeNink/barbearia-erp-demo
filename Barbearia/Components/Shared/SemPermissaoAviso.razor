@* Logado, mas sem permissao para esta tela. Mostrado pelo
   AuthorizeRouteView quando a navegacao acontece dentro do circuito. *@

@inject Autorizacao permissao

<div class="aviso-acesso">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 2 3 6v6c0 5 3.8 9.4 9 10 5.2-.6 9-5 9-10V6l-9-4zM12 8v4M12 16h.01" />
    </svg>

    <h1>Você não tem permissão para acessar esta página</h1>
    <p>Se precisa dela para trabalhar, peça ao administrador.</p>

    <a href="@inicio" class="btn-novo">Voltar ao início</a>
</div>

@code {
    private string inicio = "/";

    // Mesma regra do Destino do Login: quem nao tem o painel volta para a
    // primeira tela liberada, e nao para outro aviso de falta de permissao.
    protected override async Task OnInitializedAsync()
    {
        var permissoes = await permissao.CarregarAsync();

        if (!permissoes.PodeVer("painel"))
            inicio = permissoes.TelasVisiveis().FirstOrDefault()?.Rotas.FirstOrDefault() ?? "/";
    }
}
