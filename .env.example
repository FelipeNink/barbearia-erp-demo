# Copie para .env e troque tudo. O .env nao vai para o repositorio.
#
#   cp .env.example .env
#
# Estes valores sao de exemplo e servem so para rodar na sua maquina.

# Banco
MYSQL_ROOT_PASSWORD=troque-esta-senha-de-root
MYSQL_DATABASE=barbearia
MYSQL_USER=barbearia
MYSQL_PASSWORD=troque-esta-senha

# Primeiro acesso. Usado uma unica vez, na primeira subida. Deixando
# as duas em branco, a demonstracao cria o acesso admin / demo1234, que
# fica escrito na tela de entrada.
#ADMIN_USUARIO=admin
#ADMIN_SENHA=troque-esta-senha

# Fuso do estabelecimento. Sem ele o container fica em UTC e os horarios
# da agenda saem deslocados.
TZ=America/Sao_Paulo
